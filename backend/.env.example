# Gemini API Key (Required for transcript analysis & viral hook selection)
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# YouTube Data API v3 & Social Media Publishing (Optional)
# Set to 'auto' to use real OAuth if client_secret.json exists, or 'sandbox' for dry-run testing
YOUTUBE_UPLOAD_MODE=auto
GOOGLE_CLIENT_SECRETS_FILE=client_secret.json
